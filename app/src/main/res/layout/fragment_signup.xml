<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginText"
                    style="@style/Widget.SixBlock.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp"
                    android:text="Back to login"
                    android:textColor="@color/feed_text"
                    app:icon="@drawable/ic_arrow_back_24"
                    app:iconTint="@color/feed_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Create your account"
                    android:textColor="@color/feed_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Join your local board with details we use to personalize nearby posts."
                    android:textColor="@color/feed_muted"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:hint="Display name"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:hintTextColor="@color/feed_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email address"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:hintTextColor="@color/feed_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/birthdayLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Birthday"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:endIconDrawable="@drawable/ic_calendar_24"
                    app:endIconMode="custom"
                    app:endIconTint="@color/feed_text"
                    app:hintTextColor="@color/feed_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/birthdayInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/neighbourhoodLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Approximate neighbourhood / city area"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:hintTextColor="@color/feed_muted">

                    <AutoCompleteTextView
                        android:id="@+id/neighbourhoodInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/genderLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/profile_gender_hint"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:hintTextColor="@color/feed_muted">

                    <AutoCompleteTextView
                        android:id="@+id/genderInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Password"
                    app:boxBackgroundColor="@color/feed_search"
                    app:boxStrokeColor="@color/feed_line"
                    app:hintTextColor="@color/feed_muted"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/feed_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/feed_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signupButton"
                    style="@style/Widget.SixBlock.Button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:text="Create account" />

                <TextView
                    android:id="@+id/authStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/feed_muted"
                    android:visibility="gone" />
            </LinearLayout>

    </LinearLayout>
</ScrollView>
