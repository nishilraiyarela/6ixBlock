<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/categoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_dark"
            android:textColor="@color/surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/charcoal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sharePostButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Share post"
            android:minWidth="42dp"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_share_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/charcoal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editPostButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Edit post"
            android:minWidth="42dp"
            android:padding="0dp"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_edit_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/charcoal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deletePostButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Delete post"
            android:minWidth="42dp"
            android:padding="0dp"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_delete_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/charcoal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionMenuButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="More post actions"
            android:minWidth="42dp"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_more_horiz_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/charcoal" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/charcoal"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/metaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/charcoal"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/postImage"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="Post photo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/charcoal"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="@color/line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Comments"
        android:textColor="@color/charcoal"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
